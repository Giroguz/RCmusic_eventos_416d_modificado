# Búsqueda opcional con YouTube Data API v3.
VITE_YOUTUBE_API_KEY=

# API backend que consulta Spotify sin exponer el client secret.
VITE_SPOTIFY_API_BASE_URL=http://localhost:8787/api

# Client ID opcional para resultados directos de SoundCloud. Sin él se muestra un enlace de búsqueda.
VITE_SOUNDCLOUD_CLIENT_ID=

# Supabase: activa usuarios, persistencia y tiempo real cuando estén configuradas.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key

# No se configura ninguna clave DJ en el frontend. Cada DJ usa correo aprobado + código personal
# validado por la RPC segura de Supabase. Los pagos/planes se activan manualmente por el admin.

# PACK TODOS LOS GÉNEROS (standalone PWA under /library/)
VITE_DJ_LIBRARY_SUPABASE_URL=
VITE_DJ_LIBRARY_SUPABASE_ANON_KEY=
VITE_DJ_LIBRARY_API_BASE_URL=
VITE_DJ_LIBRARY_ADMIN_EMAIL=djgian7785@gmail.com
